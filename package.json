{
  "name": "viberails-monorepo",
  "private": true,
  "description": "Guardrails for vibe coding. Scan your codebase, generate AI context, enforce conventions.",
  "keywords": [
    "vibe-coding",
    "guardrails",
    "cli",
    "code-quality",
    "developer-tools",
    "ai-coding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ceveos/viberails.git"
  },
  "homepage": "https://viberails.sh",
  "packageManager": "pnpm@10.6.4",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "biome format --write packages/ tests/",
    "prepare": "lefthook install",
    "clean": "turbo run clean && rm -rf node_modules",
    "release": "./scripts/publish.sh",
    "release:patch": "./scripts/publish.sh patch",
    "release:minor": "./scripts/publish.sh minor",
    "release:major": "./scripts/publish.sh major",
    "release:dry": "./scripts/publish.sh --dry-run",
    "viberails": "node packages/cli/dist/index.js",
    "viberails:check": "node packages/cli/dist/index.js check",
    "viberails:fix": "node packages/cli/dist/index.js fix",
    "viberails:fix:dry": "node packages/cli/dist/index.js fix --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "lefthook": "^2.1.2",
    "tsup": "^8.5.1",
    "turbo": "^2.8.13",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
