---
const features = [
  {
    label: '01',
    title: 'Reads the room before it sets rules',
    description:
      'Framework, tooling, structure, naming, tests. It pulls defaults from the codebase you already trust instead of inventing a policy on top of it.',
  },
  {
    label: '02',
    title: 'Generates rules AI tools actually follow',
    description:
      'Scan results become .viberails/context.md — natural-language directives wired into Claude Code hooks, pre-commit checks, and CI. Not a template. Derived from your code.',
  },
];
---

<section class="mx-auto max-w-6xl px-6 pt-10 pb-16">
  <div class="flex items-center gap-3 mb-10">
    <div class="h-px flex-1 bg-blueprint-line"></div>
    <h2 class="text-xs text-text-dim tracking-[0.2em] uppercase font-normal">how it works</h2>
    <div class="h-px flex-1 bg-blueprint-line"></div>
  </div>

  <div class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-border/60 bg-border/40 md:grid-cols-2 shadow-xl shadow-black/20">
    {
      features.map((feature) => (
        <div class="glass-panel p-6 md:p-7">
          <div class="flex items-center gap-3">
            <span class="text-xs tracking-[0.25em] text-accent/50 font-bold">{feature.label}</span>
            <div class="h-px flex-1 bg-blueprint-line/70"></div>
          </div>

          <h3 class="mt-4 text-[15px] font-bold tracking-tight text-text-primary md:text-lg">{feature.title}</h3>
          <p class="mt-3 text-sm leading-7 text-text-muted">{feature.description}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-6 rounded border border-dashed border-blueprint-line bg-terminal-bg/40 px-5 py-4 text-sm leading-7 text-text-muted">
    <span class="text-text-primary">Monorepo-native.</span> Workspace detection, per-package scanning, and boundary inference included.
  </div>
</section>
