---
interface Props {
  title?: string;
}

const { title = 'terminal' } = Astro.props;
---

<div class="rounded-md border border-border/80 overflow-hidden shadow-lg shadow-black/20">
  <div class="flex items-center gap-1.5 px-3 md:px-4 py-2 bg-terminal-header border-b border-border/60">
    <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]/70"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e]/70"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-[#28c840]/70"></span>
    <span class="ml-2 text-xs text-text-dim">{title}</span>
  </div>
  <div class="bg-terminal-bg px-3 md:px-5 py-3 md:py-4 text-xs md:text-[13px] leading-[1.8] overflow-x-auto">
    <slot />
  </div>
</div>
