---
import Terminal from './terminal.astro';
---

<section id="install" class="mx-auto max-w-5xl px-6 py-20">
  <!-- Section label -->
  <div class="flex items-center gap-3 mb-10">
    <div class="h-px flex-1 bg-blueprint-line"></div>
    <span class="text-xs font-mono text-text-muted tracking-widest uppercase">install</span>
    <div class="h-px flex-1 bg-blueprint-line"></div>
  </div>

  <div class="max-w-2xl mx-auto space-y-4">
    <Terminal title="npm">
      <div>
        <span class="text-text-muted">$</span>
        <span class="text-text-primary"> npx viberails</span>
      </div>
    </Terminal>

    <Terminal title="pnpm">
      <div>
        <span class="text-text-muted">$</span>
        <span class="text-text-primary"> pnpm dlx viberails</span>
      </div>
    </Terminal>
  </div>

  <p class="text-center text-text-muted text-sm mt-8 font-mono">
    No install needed. Runs once, generates config, done.
  </p>
</section>
