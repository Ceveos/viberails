---
import Terminal from './terminal.astro';

const lifecycle = [
  {
    stage: 'During AI edits',
    description: 'Claude Code PostToolUse hook validates files as they\'re written. Catches violations mid-session, not after.',
  },
  {
    stage: 'On commit',
    description: 'Pre-commit hook runs check --staged. Optional typecheck and lint hooks included.',
  },
  {
    stage: 'In pull requests',
    description: 'GitHub Actions workflow runs check --enforce to block merges with violations.',
  },
];

const commands = [
  {
    cmd: 'viberails check --staged',
    description: 'The everyday safety net.',
  },
  {
    cmd: 'viberails sync',
    description: 'Re-scan and refresh without losing edits.',
  },
  {
    cmd: 'viberails fix --dry-run',
    description: 'Preview auto-corrections before touching files.',
  },
];
---

<section class="border-y border-border/30 bg-terminal-bg/30">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex items-center gap-3 mb-10">
      <div class="h-px flex-1 bg-blueprint-line"></div>
      <h2 class="text-xs text-text-dim tracking-[0.2em] uppercase font-normal">where it shows up</h2>
      <div class="h-px flex-1 bg-blueprint-line"></div>
    </div>

    <div class="grid gap-8 lg:grid-cols-[1fr_1fr]">
      <div class="space-y-4">
        {
          lifecycle.map((item, index) => (
            <div class={`rounded border border-border/80 bg-blueprint-bg/60 p-5 reveal reveal-delay-${Math.min(index + 1, 5)}`}>
              <div class="text-[10px] uppercase tracking-[0.24em] text-accent/60">{item.stage}</div>
              <p class="mt-3 text-sm leading-7 text-text-muted">{item.description}</p>
            </div>
          ))
        }
      </div>

      <div class="space-y-5">
        <Terminal title="claude code">
          <div class="text-text-muted">⏺ Refactoring display module into smaller files:</div>
          <div class="mt-2 text-text-muted">⏺ <span class="text-text-primary">Update</span>(src/display.ts)</div>
          <div class="text-text-dim">&nbsp;&nbsp;⎿&nbsp;&nbsp;Removed 14 lines</div>

          <div class="mt-2">
            <span class="text-text-dim">&nbsp;&nbsp;⎿&nbsp;&nbsp;</span><span class="text-red">PostToolUse hook returned error</span>
          </div>
          <div class="text-text-dim">&nbsp;&nbsp;⎿&nbsp;&nbsp;<span class="text-amber">src/display.ts: 312 lines (max 300).</span></div>
          <div class="text-text-dim">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-amber">Split into focused modules.</span></div>

          <div class="mt-3 text-text-muted">⏺ The file is still over the 300-line limit.</div>
          <div class="text-text-muted">&nbsp;&nbsp;Let me extract more code to fix this.</div>

          <div class="mt-2 text-text-muted">⏺ <span class="text-text-primary">Update</span>(src/display.ts)</div>
          <div class="text-text-dim">&nbsp;&nbsp;⎿&nbsp;&nbsp;Removed 28 lines, added 2 lines</div>
          <div class="mt-2 text-green">&nbsp;&nbsp;✓ No violations</div>
        </Terminal>

        <div class="grid gap-3 sm:grid-cols-3">
          {
            commands.map((command) => (
              <div class="rounded border border-border/70 bg-blueprint-bg/60 px-4 py-4">
                <div class="text-xs text-accent">{command.cmd}</div>
                <p class="mt-2 text-xs leading-6 text-text-muted">{command.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
