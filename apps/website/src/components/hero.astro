---
import Terminal from './terminal.astro';

const surfaces = ['AI edits', 'pre-commit', 'PR checks'];
---

<section class="mx-auto max-w-6xl px-6 pt-16 pb-10 md:pt-22 md:pb-14">
  <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
    <div class="reveal">
      <div class="inline-flex items-center gap-2 rounded-full border border-border-accent bg-accent/8 px-3 py-1.5 text-[10px] uppercase tracking-[0.25em] text-accent">
        open source CLI tool
      </div>

      <h1 class="mt-5 max-w-2xl text-3xl font-bold leading-[1.05] tracking-tight text-text-primary md:text-5xl lg:text-[3.75rem]">
        Your codebase has conventions.
        <br />
        Now enforce them.
      </h1>

      <p class="mt-5 max-w-xl text-sm leading-7 text-text-muted md:text-[15px]">
        One scan, real defaults, no config to start. viberails reads your existing project,
        generates AI context files, and enforces the rules it finds.
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href="#install"
          class="inline-flex items-center justify-center rounded border border-accent/30 bg-accent/10 px-5 py-3 text-xs uppercase tracking-[0.18em] text-accent transition-all hover:border-accent/50 hover:bg-accent/16"
        >
          Get started
        </a>
        <a
          href="https://github.com/Ceveos/viberails"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded border border-border px-5 py-3 text-xs uppercase tracking-[0.18em] text-text-muted transition-all hover:border-border-accent hover:text-text-primary"
        >
          GitHub
        </a>
      </div>

      <div class="mt-7 flex flex-wrap gap-2">
        {
          surfaces.map((item) => (
            <span class="rounded-full border border-border/80 bg-terminal-bg/70 px-3 py-1.5 text-[11px] uppercase tracking-[0.18em] text-text-dim">
              {item}
            </span>
          ))
        }
      </div>
    </div>

    <div class="reveal reveal-delay-2">
      <Terminal title="~/workspace">
        <div>
          <span class="text-text-dim">$</span>
          <span class="text-text-primary"> npx viberails</span>
        </div>
        <div class="mt-2 text-text-muted">Scan complete</div>

        <div class="mt-3 text-text-dim text-[11px] uppercase tracking-[0.24em]">Ready to initialize</div>
        <div class="ml-2 text-text-primary">
          monorepo <span class="text-text-dim">&middot;</span> 10 packages <span class="text-text-dim">&middot;</span> TypeScript 5
        </div>
        <div class="ml-2 text-text-muted">pnpm &middot; ESLint 9 &middot; Prettier 3 &middot; Jest 29</div>

        <div class="mt-3 text-text-dim text-[11px] uppercase tracking-[0.24em]">Rules</div>
        <div class="ml-2 text-text-muted"><span class="text-green">✓</span> 300-line file cap</div>
        <div class="ml-2 text-text-muted"><span class="text-green">✓</span> kebab-case naming</div>
        <div class="ml-2 text-text-muted"><span class="text-green">✓</span> missing tests enforced</div>

        <div class="mt-3 text-text-dim text-[11px] uppercase tracking-[0.24em]">Next step</div>
        <div class="ml-2 text-accent">› Accept defaults</div>
        <div class="ml-2 text-text-dim">Customize rules</div>
        <div class="ml-2 text-text-dim cursor">Review detected details</div>
      </Terminal>
    </div>
  </div>
</section>
