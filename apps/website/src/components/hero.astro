---
import Terminal from './terminal.astro';
---

<section class="mx-auto max-w-5xl px-6 pt-24 pb-20">
  <!-- Blueprint annotation frame -->
  <div class="relative mb-12">
    <!-- Corner markers -->
    <div class="absolute -top-3 -left-3 w-6 h-6 border-t-2 border-l-2 border-blueprint-line"></div>
    <div class="absolute -top-3 -right-3 w-6 h-6 border-t-2 border-r-2 border-blueprint-line"></div>
    <div class="absolute -bottom-3 -left-3 w-6 h-6 border-b-2 border-l-2 border-blueprint-line"></div>
    <div class="absolute -bottom-3 -right-3 w-6 h-6 border-b-2 border-r-2 border-blueprint-line"></div>

    <div class="py-8 px-4 text-center">
      <h1 class="font-mono font-bold text-4xl md:text-5xl lg:text-6xl tracking-tight mb-6">
        <span class="text-accent">Guardrails</span> for<br />vibe coding.
      </h1>
      <p class="text-text-muted text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
        Scan your codebase, generate AI context, and enforce architectural
        conventions. No config to write — it learns from your code.
      </p>
    </div>
  </div>

  <!-- Dimension line annotation -->
  <div class="flex items-center gap-3 mb-6">
    <div class="h-px flex-1 bg-blueprint-line"></div>
    <span class="text-xs font-mono text-text-muted tracking-widest uppercase">demo</span>
    <div class="h-px flex-1 bg-blueprint-line"></div>
  </div>

  <!-- Terminal demo -->
  <div class="max-w-2xl mx-auto">
    <Terminal title="~/project">
      <div>
        <span class="text-text-muted">$</span>
        <span class="text-text-primary"> npx viberails</span>
      </div>
      <div class="mt-3 text-text-muted">Scanning project...</div>
      <div class="mt-1">
        <span class="text-accent">Detected:</span>
        <span class="text-text-primary"> Next.js 15, TypeScript, Tailwind, Vitest</span>
      </div>
      <div class="mt-3">
        <span class="text-green-400">✓</span>
        <span class="text-text-primary"> kebab-case</span>
        <span class="text-text-muted"> (94% consistency)</span>
      </div>
      <div>
        <span class="text-green-400">✓</span>
        <span class="text-text-primary"> max 300 lines</span>
        <span class="text-text-muted"> (default)</span>
      </div>
      <div>
        <span class="text-green-400">✓</span>
        <span class="text-text-primary"> test coverage 80%</span>
      </div>
      <div class="mt-3">
        <span class="text-text-muted">Generated</span>
        <span class="text-accent"> viberails.config.json</span>
      </div>
      <div>
        <span class="text-text-muted">Generated</span>
        <span class="text-accent"> .viberails/context.md</span>
      </div>
    </Terminal>
  </div>

  <!-- CTA buttons -->
  <div class="flex items-center justify-center gap-4 mt-10">
    <a
      href="#install"
      class="px-6 py-2.5 bg-accent/10 border border-accent/30 text-accent font-mono text-sm rounded hover:bg-accent/20 transition-colors"
    >
      Get Started
    </a>
    <a
      href="https://github.com/Ceveos/viberails"
      class="px-6 py-2.5 border border-border text-text-muted font-mono text-sm rounded hover:text-text-primary hover:border-text-muted transition-colors"
      target="_blank"
      rel="noopener noreferrer"
    >
      View on GitHub
    </a>
  </div>
</section>
