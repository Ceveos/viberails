---
import Terminal from './terminal.astro';

const surfaces = ['AI edits', 'pre-commit', 'PR checks'];
---

<section class="mx-auto max-w-6xl px-6 pt-16 pb-10 md:pt-22 md:pb-14">
  <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
    <div class="reveal">
      <div class="inline-flex items-center gap-2 rounded-full border border-border-accent bg-accent/8 px-3 py-1.5 text-[10px] uppercase tracking-[0.25em] text-accent">
        open source CLI tool
      </div>

      <h1 class="mt-5 max-w-2xl text-3xl font-bold leading-[1.05] tracking-tight text-text-primary md:text-5xl lg:text-[3.75rem]">
        Your codebase has conventions.
        <br />
        Now enforce them.
      </h1>

      <p class="mt-5 max-w-xl text-sm leading-7 text-text-muted md:text-[15px]">
        One scan, real defaults, no config to start. viberails reads your existing project,
        generates AI context files, and enforces the rules it finds.
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href="#install"
          class="inline-flex items-center justify-center rounded border border-accent/30 bg-accent/10 px-5 py-3 text-xs uppercase tracking-[0.18em] text-accent transition-all hover:border-accent/50 hover:bg-accent/16"
        >
          Get started
        </a>
        <a
          href="https://github.com/Ceveos/viberails"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded border border-border px-5 py-3 text-xs uppercase tracking-[0.18em] text-text-muted transition-all hover:border-border-accent hover:text-text-primary"
        >
          GitHub
        </a>
      </div>

      <div class="mt-7 flex flex-wrap gap-2">
        {
          surfaces.map((item) => (
            <span class="rounded-full border border-border/80 bg-terminal-bg/70 px-3 py-1.5 text-[11px] uppercase tracking-[0.18em] text-text-dim">
              {item}
            </span>
          ))
        }
      </div>
    </div>

    <div class="reveal reveal-delay-2">
      <Terminal title="~/workspace">
        <div>
          <span class="text-text-dim">$</span>
          <span class="text-text-primary"> npx viberails</span>
        </div>
        <div class="mt-2 text-text-muted">Scanning... done</div>

        <div class="mt-3 ml-2 text-text-primary">
          monorepo <span class="text-text-dim">&middot;</span> 10 packages <span class="text-text-dim">&middot;</span> TypeScript 5
        </div>
        <div class="ml-2 text-text-muted">pnpm &middot; Biome &middot; Vitest</div>

        <div class="mt-3"><span class="text-accent">◆</span> <span class="text-text-primary">Configure viberails</span></div>
        <div><span class="text-accent">│</span>  <span class="text-green">✓</span> <span class="text-text-muted">Max file size</span> <span class="text-text-dim">300 lines</span></div>
        <div><span class="text-accent">│</span>  <span class="text-green">✓</span> <span class="text-text-muted">Default file naming</span> <span class="text-text-dim">kebab-case (detected)</span></div>
        <div><span class="text-accent">│</span>  <span class="text-green">✓</span> <span class="text-text-muted">Missing tests</span> <span class="text-text-dim">enforced</span></div>
        <div><span class="text-accent">│</span>  <span class="text-green">✓</span> <span class="text-text-muted">Coverage</span> <span class="text-text-dim">80%</span></div>
        <div><span class="text-accent">│</span>  <span class="text-text-dim">-</span> <span class="text-text-dim">Advanced naming</span> <span class="text-text-dim">kebab-case, components, hooks, alias</span></div>
        <div><span class="text-accent">│</span>  <span class="text-text-dim">-</span> <span class="text-text-dim">Integrations</span> <span class="text-text-dim">not configured</span></div>
        <div><span class="text-accent">│</span>    <span class="text-text-dim">Reset all to defaults</span></div>
        <div><span class="text-accent">│</span>    <span class="text-text-dim">Review scan details</span></div>
        <div><span class="text-accent">│</span>  <span class="text-accent">›</span> <span class="text-accent cursor">Done — write config</span></div>
      </Terminal>
    </div>
  </div>
</section>
