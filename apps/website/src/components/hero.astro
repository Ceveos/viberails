---
import Terminal from './terminal.astro';

const surfaces = ['AI edits', 'pre-commit', 'PR checks'];
---

<section class="mx-auto max-w-6xl px-6 pt-16 pb-10 md:pt-22 md:pb-14">
  <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
    <div class="reveal">
      <div class="inline-flex items-center gap-2 rounded-full border border-border-accent bg-accent/8 px-3 py-1.5 text-[10px] uppercase tracking-[0.25em] text-accent">
        open source CLI tool
      </div>

      <h1 class="mt-5 max-w-2xl text-3xl font-bold leading-[1.05] tracking-tight text-text-primary md:text-5xl lg:text-[3.75rem]">
        Scan your codebase.
        <br />
        Generate AI guardrails.
      </h1>

      <p class="mt-5 max-w-xl text-sm leading-7 text-text-muted md:text-[15px]">
        viberails reads your existing project &mdash; framework, structure, naming, tests &mdash;
        and generates rules that AI tools, hooks, and CI actually follow.
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href="#install"
          class="inline-flex items-center justify-center rounded border border-accent/30 bg-accent/10 px-5 py-3 text-xs uppercase tracking-[0.18em] text-accent transition-all hover:border-accent/50 hover:bg-accent/16"
        >
          Get started
        </a>
        <a
          href="https://github.com/Ceveos/viberails"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded border border-border px-5 py-3 text-xs uppercase tracking-[0.18em] text-text-muted transition-all hover:border-border-accent hover:text-text-primary"
        >
          GitHub
        </a>
      </div>

      <div class="mt-7 flex flex-wrap gap-2">
        {
          surfaces.map((item) => (
            <span class="rounded-full border border-border/80 bg-terminal-bg/70 px-3 py-1.5 text-[11px] uppercase tracking-[0.18em] text-text-dim">
              {item}
            </span>
          ))
        }
      </div>
    </div>

    <div class="reveal reveal-delay-2">
      <Terminal title="~/workspace">
        <div>
          <span class="text-text-dim">$</span>
          <span class="text-text-primary"> npx viberails</span>
        </div>

        <div class="mt-3"><span class="text-accent">┌</span>  <span class="text-text-primary">viberails</span></div>
        <div><span class="text-accent">│</span></div>
        <div><span class="text-green">◇</span>  <span class="text-text-muted">Scan complete</span></div>
        <div><span class="text-accent">│</span></div>
        <div><span class="text-accent">◇</span>  <span class="text-text-primary">Project readiness</span> <span class="text-accent">──────────────╮</span></div>
        <div><span class="text-accent">│</span>&nbsp;&nbsp;<span class="text-green">✓</span>&nbsp;<span class="text-text-muted">Test runner</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-text-primary">vitest</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-accent">│</span></div>
        <div><span class="text-accent">│</span>&nbsp;&nbsp;<span class="text-green">✓</span>&nbsp;<span class="text-text-muted">Hook manager</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-text-primary">Lefthook</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-accent">│</span></div>
        <div><span class="text-accent">│</span>&nbsp;&nbsp;<span class="text-green">✓</span>&nbsp;<span class="text-text-muted">Linter</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-text-primary">Biome</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-accent">│</span></div>
        <div><span class="text-accent">│</span>&nbsp;&nbsp;<span class="text-green">✓</span>&nbsp;<span class="text-text-muted">Typecheck</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-text-primary">tsc --noEmit</span>&nbsp;<span class="text-accent">│</span></div>
        <div><span class="text-accent">├─────────────────────────────────╯</span></div>
        <div><span class="text-accent">│</span></div>
        <div><span class="text-accent">◆</span>  <span class="text-text-primary">Configure viberails</span></div>
        <div><span class="text-accent">│</span>  <span class="text-accent">●</span> <span class="text-green">✓</span> <span class="text-text-primary">Max file size</span> <span class="text-text-dim">(300 lines)</span></div>
        <div><span class="text-accent">│</span>  <span class="text-text-dim">○</span> <span class="text-green">✓</span> <span class="text-text-muted">File naming</span> <span class="text-text-dim">(kebab-case, detected)</span></div>
        <div><span class="text-accent">│</span>  <span class="text-text-dim">○</span> <span class="text-green">✓</span> <span class="text-text-muted">Missing tests</span> <span class="text-text-dim">(enforced)</span></div>
        <div><span class="text-accent">│</span>  <span class="text-text-dim">○</span> <span class="text-green">✓</span> <span class="text-text-muted">Coverage</span> <span class="text-text-dim">(80%)</span></div>
        <div><span class="text-accent">│</span>  <span class="text-text-dim">○</span> <span class="text-text-dim">-</span> <span class="text-text-muted">AI context</span> <span class="text-text-dim">(none set)</span></div>
        <div><span class="text-accent">│</span>  <span class="text-text-dim">○</span> <span class="text-green">✓</span> <span class="text-text-muted">Per-package overrides</span> <span class="text-text-dim">(3 packages)</span></div>
        <div><span class="text-accent">│</span>  <span class="text-text-dim">○</span> <span class="text-text-dim">-</span> <span class="text-text-muted">Boundaries</span> <span class="text-text-dim">(not enabled)</span></div>
        <div><span class="text-accent">│</span>  <span class="text-text-dim">○</span>   <span class="text-text-dim">Reset all to defaults</span></div>
        <div><span class="text-accent">│</span>  <span class="text-text-dim">○</span>   <span class="text-text-dim">Review scan details</span></div>
        <div><span class="text-accent">│</span>  <span class="text-text-dim">○</span>   <span class="text-text-dim cursor">Done — write config</span></div>
        <div><span class="text-accent">└</span></div>
      </Terminal>
    </div>
  </div>
</section>
