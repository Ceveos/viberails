{
  "$schema": "https://viberails.sh/schema/v2.json",
  "version": 2,
  "name": "viberails",
  "enforcement": "warn",
  "rules": {
    "maxFileLines": 300,
    "maxTestFileLines": 0,
    "requireTests": true,
    "enforceNaming": true,
    "enforceBoundaries": true
  },
  "boundaries": {
    "deny": {
      "@viberails/config": [
        "viberails",
        "@viberails/context",
        "@viberails/graph",
        "@viberails/scanner"
      ],
      "@viberails/context": [
        "viberails",
        "@viberails/graph",
        "@viberails/scanner"
      ],
      "@viberails/graph": [
        "viberails",
        "@viberails/config",
        "@viberails/context",
        "@viberails/scanner"
      ],
      "@viberails/scanner": [
        "viberails",
        "@viberails/config",
        "@viberails/context",
        "@viberails/graph"
      ],
      "@viberails/types": [
        "viberails",
        "@viberails/config",
        "@viberails/context",
        "@viberails/graph",
        "@viberails/scanner"
      ]
    }
  },
  "defaults": {
    "stack": {
      "language": "typescript@5",
      "packageManager": "npm",
      "linter": "biome@2",
      "formatter": "biome@2",
      "testRunner": "vitest@4"
    },
    "structure": {
      "srcDir": "src"
    }
  },
  "packages": [
    {
      "name": "viberails",
      "path": "packages/cli",
      "structure": {
        "utils": "src/utils",
        "testPattern": "*.test.ts"
      },
      "conventions": {
        "fileNaming": "kebab-case"
      }
    },
    {
      "name": "@viberails/config",
      "path": "packages/config",
      "structure": {
        "testPattern": "*.test.ts"
      },
      "conventions": {
        "fileNaming": "kebab-case"
      }
    },
    {
      "name": "@viberails/context",
      "path": "packages/context"
    },
    {
      "name": "@viberails/graph",
      "path": "packages/graph",
      "structure": {
        "testPattern": "*.test.ts"
      },
      "conventions": {
        "fileNaming": "kebab-case"
      }
    },
    {
      "name": "@viberails/scanner",
      "path": "packages/scanner",
      "structure": {
        "utils": "src/utils",
        "testPattern": "*.test.ts"
      },
      "conventions": {
        "fileNaming": "kebab-case"
      }
    },
    {
      "name": "@viberails/types",
      "path": "packages/types"
    }
  ],
  "_meta": {
    "lastSync": "2026-03-08T17:14:56.574Z",
    "packages": {
      "packages/cli": {
        "conventions": {
          "fileNaming": {
            "confidence": "medium",
            "consistency": 71,
            "detected": true
          }
        }
      },
      "packages/config": {
        "conventions": {
          "fileNaming": {
            "confidence": "medium",
            "consistency": 75
          }
        }
      },
      "packages/graph": {
        "conventions": {
          "fileNaming": {
            "confidence": "high",
            "consistency": 100
          }
        }
      },
      "packages/scanner": {
        "conventions": {
          "fileNaming": {
            "confidence": "medium",
            "consistency": 85
          }
        }
      }
    }
  }
}
