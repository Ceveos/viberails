{
  "$schema": "https://viberails.sh/schema/v1.json",
  "version": 1,
  "name": "viberails",
  "enforcement": "warn",
  "stack": {
    "language": "typescript@5",
    "packageManager": "pnpm",
    "linter": "biome@2",
    "formatter": "biome@2",
    "testRunner": "vitest@4"
  },
  "structure": {
    "srcDir": "src",
    "utils": "packages/cli/src/utils",
    "tests": "tests",
    "testPattern": "*.test.ts"
  },
  "conventions": {
    "fileNaming": {
      "value": "kebab-case",
      "_confidence": "medium",
      "_consistency": 85,
      "_detected": true
    }
  },
  "rules": {
    "maxFileLines": 300,
    "maxTestFileLines": 0,
    "maxFunctionLines": 50,
    "requireTests": true,
    "enforceNaming": true,
    "enforceBoundaries": true
  },
  "ignore": [
    "**/*.d.ts",
    "dist/**",
    "node_modules/**",
    "tests/fixtures/**"
  ],
  "workspace": {
    "packages": [
      "packages/cli",
      "packages/config",
      "packages/context",
      "packages/graph",
      "packages/scanner",
      "packages/types"
    ],
    "isMonorepo": true
  },
  "boundaries": [
    {
      "from": "@viberails/types",
      "to": "@viberails/scanner",
      "allow": false,
      "reason": "@viberails/types should not depend on @viberails/scanner"
    },
    {
      "from": "@viberails/types",
      "to": "@viberails/config",
      "allow": false,
      "reason": "@viberails/types should not depend on @viberails/config"
    },
    {
      "from": "@viberails/types",
      "to": "@viberails/context",
      "allow": false,
      "reason": "@viberails/types should not depend on @viberails/context"
    },
    {
      "from": "@viberails/types",
      "to": "@viberails/graph",
      "allow": false,
      "reason": "@viberails/types should not depend on @viberails/graph"
    },
    {
      "from": "@viberails/types",
      "to": "viberails",
      "allow": false,
      "reason": "@viberails/types should not depend on viberails"
    },
    {
      "from": "@viberails/scanner",
      "to": "@viberails/config",
      "allow": false,
      "reason": "@viberails/scanner should not depend on @viberails/config"
    },
    {
      "from": "@viberails/scanner",
      "to": "@viberails/context",
      "allow": false,
      "reason": "@viberails/scanner should not depend on @viberails/context"
    },
    {
      "from": "@viberails/scanner",
      "to": "@viberails/graph",
      "allow": false,
      "reason": "@viberails/scanner should not depend on @viberails/graph"
    },
    {
      "from": "@viberails/scanner",
      "to": "viberails",
      "allow": false,
      "reason": "@viberails/scanner should not depend on viberails"
    },
    {
      "from": "@viberails/config",
      "to": "@viberails/scanner",
      "allow": false,
      "reason": "@viberails/config should not depend on @viberails/scanner"
    },
    {
      "from": "@viberails/config",
      "to": "@viberails/context",
      "allow": false,
      "reason": "@viberails/config should not depend on @viberails/context"
    },
    {
      "from": "@viberails/config",
      "to": "@viberails/graph",
      "allow": false,
      "reason": "@viberails/config should not depend on @viberails/graph"
    },
    {
      "from": "@viberails/config",
      "to": "viberails",
      "allow": false,
      "reason": "@viberails/config should not depend on viberails"
    },
    {
      "from": "@viberails/context",
      "to": "@viberails/scanner",
      "allow": false,
      "reason": "@viberails/context should not depend on @viberails/scanner"
    },
    {
      "from": "@viberails/context",
      "to": "@viberails/graph",
      "allow": false,
      "reason": "@viberails/context should not depend on @viberails/graph"
    },
    {
      "from": "@viberails/context",
      "to": "viberails",
      "allow": false,
      "reason": "@viberails/context should not depend on viberails"
    },
    {
      "from": "@viberails/graph",
      "to": "@viberails/scanner",
      "allow": false,
      "reason": "@viberails/graph should not depend on @viberails/scanner"
    },
    {
      "from": "@viberails/graph",
      "to": "@viberails/config",
      "allow": false,
      "reason": "@viberails/graph should not depend on @viberails/config"
    },
    {
      "from": "@viberails/graph",
      "to": "@viberails/context",
      "allow": false,
      "reason": "@viberails/graph should not depend on @viberails/context"
    },
    {
      "from": "@viberails/graph",
      "to": "viberails",
      "allow": false,
      "reason": "@viberails/graph should not depend on viberails"
    }
  ],
  "packages": [
    {
      "name": "viberails",
      "path": "packages/cli",
      "stack": {
        "formatter": "biome@2"
      }
    },
    {
      "name": "@viberails/config",
      "path": "packages/config",
      "stack": {
        "formatter": "biome@2"
      }
    },
    {
      "name": "@viberails/context",
      "path": "packages/context",
      "stack": {
        "formatter": "biome@2"
      }
    },
    {
      "name": "@viberails/graph",
      "path": "packages/graph",
      "stack": {
        "formatter": "biome@2"
      },
      "conventions": {
        "fileNaming": {
          "value": "kebab-case",
          "_confidence": "high",
          "_consistency": 100
        }
      }
    },
    {
      "name": "@viberails/scanner",
      "path": "packages/scanner",
      "stack": {
        "formatter": "biome@2"
      },
      "conventions": {
        "fileNaming": {
          "value": "kebab-case",
          "_confidence": "medium",
          "_consistency": 83
        }
      }
    },
    {
      "name": "@viberails/types",
      "path": "packages/types",
      "stack": {
        "formatter": "biome@2"
      }
    }
  ]
}
