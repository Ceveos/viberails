{
  "$schema": "https://viberails.sh/schema/v1.json",
  "version": 1,
  "name": "viberails",
  "rules": {
    "maxFileLines": 300,
    "maxTestFileLines": 0,
    "testCoverage": 80,
    "enforceNaming": true,
    "enforceBoundaries": true,
    "enforceMissingTests": true
  },
  "ignore": [
    "tests/fixtures/**"
  ],
  "boundaries": {
    "deny": {
      "@viberails/config": [
        "viberails",
        "@viberails/context",
        "@viberails/graph",
        "@viberails/scanner"
      ],
      "@viberails/context": [
        "viberails",
        "@viberails/graph",
        "@viberails/scanner"
      ],
      "@viberails/graph": [
        "viberails",
        "@viberails/config",
        "@viberails/context",
        "@viberails/scanner"
      ],
      "@viberails/scanner": [
        "viberails",
        "@viberails/config",
        "@viberails/context",
        "@viberails/graph"
      ],
      "@viberails/types": [
        "viberails",
        "@viberails/config",
        "@viberails/context",
        "@viberails/graph",
        "@viberails/scanner"
      ]
    }
  },
  "defaults": {
    "stack": {
      "language": "typescript@5",
      "packageManager": "pnpm",
      "linter": "biome@2",
      "formatter": "biome@2",
      "testRunner": "vitest@4"
    },
    "structure": {
      "srcDir": "src",
      "testPattern": "*.test.ts"
    }
  },
  "packages": [
    {
      "name": "viberails",
      "path": "packages/cli",
      "structure": {
        "utils": "src/utils",
        "tests": "src/commands"
      },
      "rules": {
        "testCoverage": 75
      },
      "conventions": {
        "fileNaming": "kebab-case"
      }
    },
    {
      "name": "@viberails/config",
      "path": "packages/config",
      "structure": {
        "tests": "src"
      },
      "conventions": {
        "fileNaming": "kebab-case"
      }
    },
    {
      "name": "@viberails/context",
      "path": "packages/context"
    },
    {
      "name": "@viberails/graph",
      "path": "packages/graph",
      "conventions": {
        "fileNaming": "kebab-case"
      }
    },
    {
      "name": "@viberails/scanner",
      "path": "packages/scanner",
      "structure": {
        "utils": "src/utils"
      },
      "conventions": {
        "fileNaming": "kebab-case"
      }
    },
    {
      "name": "@viberails/types",
      "path": "packages/types",
      "rules": {
        "testCoverage": 0,
        "enforceMissingTests": false
      }
    },
    {
      "name": "@viberails/website",
      "path": "apps/website",
      "stack": {
        "framework": "astro@5",
        "styling": "tailwindcss@4"
      },
      "structure": {
        "pages": "src/pages",
        "components": "src/components"
      },
      "rules": {
        "enforceMissingTests": false,
        "testCoverage": 0
      }
    }
  ],
  "_meta": {
    "lastSync": "2026-03-09T04:17:26.193Z",
    "packages": {
      "packages/cli": {
        "conventions": {
          "fileNaming": {
            "value": "kebab-case",
            "confidence": "medium",
            "consistency": 78
          }
        }
      },
      "packages/config": {
        "conventions": {
          "fileNaming": {
            "value": "kebab-case",
            "confidence": "medium",
            "consistency": 78
          }
        }
      },
      "packages/graph": {
        "conventions": {
          "fileNaming": {
            "value": "kebab-case",
            "confidence": "high",
            "consistency": 100
          }
        }
      },
      "packages/scanner": {
        "conventions": {
          "fileNaming": {
            "value": "kebab-case",
            "confidence": "medium",
            "consistency": 86
          }
        }
      }
    }
  }
}
